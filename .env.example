# Object storage, one of two ways:
#
# 1. Inside an ai-space workspace (preferred): leave the R2_* lines out. ai-space
#    reads `storage.blobs` from space.yaml and writes BLOB_URL + S3_ENDPOINT /
#    S3_REGION / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY into
#    ~/.ai-space/data/dot-lib/space.env, which the systemd unit loads. For local
#    dev: `eval "$(bun <ai-space>/src/index.ts env dot-lib)"`.
#
# 2. Standalone: Cloudflare R2 (S3-compatible) credentials. Create a bucket + API
#    token at: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=dot-lib

# Optional: override the S3 endpoint (e.g. MinIO / local testing).
# When set, R2_ACCOUNT_ID is not required.
# R2_ENDPOINT=http://127.0.0.1:9000

# Server port (host side for docker compose)
PORT=8787
